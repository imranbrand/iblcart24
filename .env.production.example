# ============================================================
# IBL CART 24 - LIVE SERVER .env TEMPLATE
# Copy to .env on the server, then fill every empty value.
# After editing run:  php artisan config:cache
# Then check:         php artisan shop:launch-check
# ============================================================

APP_NAME="IBL CART 24"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Real emails (order confirmation)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# SMS
SMS_DRIVER=bulksmsbd
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ON_ORDER_PLACED=true
SMS_ON_STATUS_CHANGE=true

# Steadfast Courier
STEADFAST_ENABLED=true
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Backups
BACKUP_KEEP_DAYS=14
BACKUP_TIME=03:00

# Shop details (can also be set in Admin > Settings)
SHOP_PHONE=
SHOP_WHATSAPP=
SHOP_EMAIL=
SHOP_ADDRESS=

FRAUD_GUARD_ENABLED=true
FRAUD_MAX_ORDERS_PER_DAY=5
FRAUD_MAX_CANCELLED=3
ABANDONED_CART_ENABLED=true
ABANDONED_CART_DELAY_MINUTES=60
ABANDONED_CART_MAX_AGE_HOURS=72

ONLINE_PAYMENT_ENABLED=false
